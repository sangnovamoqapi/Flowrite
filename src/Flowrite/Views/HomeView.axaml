<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Flowrite.ViewModels"
             xmlns:models="clr-namespace:Flowrite.Models"
             x:Class="Flowrite.Views.HomeView"
             x:DataType="vm:HomeViewModel">

  <Grid RowDefinitions="Auto,*">

    <!-- Top bar -->
    <Border Grid.Row="0" Padding="40,36,40,0">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <TextBlock Text="✦" FontSize="22" Foreground="{StaticResource Brush.Accent}" VerticalAlignment="Center"/>
          <TextBlock Text="Flowrite" FontSize="22" FontWeight="Bold"
                     Foreground="{StaticResource Brush.TextPrimary}" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
          <Button Classes="ghost" Command="{Binding OpenSearchCommand}" Content="Search" />
          <Button Classes="ghost" Command="{Binding OpenSettingsCommand}" Content="Settings" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Main content -->
    <ScrollViewer Grid.Row="1" Padding="40,40,40,40">
      <Grid RowDefinitions="Auto,Auto,*" ColumnDefinitions="*,320">

        <!-- Hero CTA -->
        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="8" Margin="0,0,0,48">
          <TextBlock Text="What are you thinking about?" FontSize="36" FontWeight="Light"
                     Foreground="{StaticResource Brush.TextPrimary}" TextWrapping="Wrap"/>
          <TextBlock Text="Start a session. Write without stopping. Let the thought complete itself."
                     FontSize="16" Foreground="{StaticResource Brush.TextSecondary}"
                     TextWrapping="Wrap" Margin="0,4,0,0"/>
          <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,20,0,0">
            <Button Classes="primary" Command="{Binding StartNewSessionCommand}"
                    Content="New Writing Session" FontSize="16" Padding="28,14"/>
            <Button Classes="ghost" Command="{Binding OpenLibraryCommand}"
                    Content="Essays" FontSize="16" Padding="20,14"/>
          </StackPanel>
        </StackPanel>

        <!-- Recent Essays panel -->
        <StackPanel Grid.Row="0" Grid.RowSpan="3" Grid.Column="1"
                    Margin="40,0,0,0" Spacing="12">

          <TextBlock Text="RECENT" FontSize="11" FontWeight="SemiBold" LetterSpacing="3"
                     Foreground="{StaticResource Brush.TextMuted}" Margin="0,0,0,4"/>

          <ItemsControl ItemsSource="{Binding RecentEssays}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="models:Essay">
                <Button Command="{Binding $parent[UserControl].((vm:HomeViewModel)DataContext).OpenEssayCommand}"
                        CommandParameter="{Binding}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Padding="16,14" Margin="0,0,0,6"
                        Background="{StaticResource Brush.Surface}"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Cursor="Hand">
                  <Grid RowDefinitions="Auto,Auto">
                    <TextBlock Grid.Row="0" Text="{Binding Title}" FontSize="14" FontWeight="Medium"
                               Foreground="{StaticResource Brush.TextPrimary}"
                               TextTrimming="CharacterEllipsis"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                      <TextBlock Text="{Binding WordCount, StringFormat='{}{0} words'}"
                                 FontSize="12" Foreground="{StaticResource Brush.TextMuted}"/>
                      <TextBlock Text="·" FontSize="12" Foreground="{StaticResource Brush.TextMuted}"/>
                      <TextBlock Text="{Binding Date, StringFormat='{}{0:MMM d}'}"
                                 FontSize="12" Foreground="{StaticResource Brush.TextMuted}"/>
                    </StackPanel>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Button Classes="ghost" Command="{Binding OpenLibraryCommand}"
                  Content="View all essays →" FontSize="13"
                  HorizontalAlignment="Left" Padding="0,4"/>

        </StackPanel>

      </Grid>
    </ScrollViewer>
  </Grid>

</UserControl>
