<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Flowrite.ViewModels"
             x:Class="Flowrite.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- Top bar -->
    <Border Grid.Row="0" Padding="40,36,40,24">
      <Grid ColumnDefinitions="Auto,*">
        <Button Grid.Column="0" Classes="ghost" Command="{Binding GoBackCommand}"
                Content="← Back" Padding="0,8"/>
        <TextBlock Grid.Column="1" Text="Settings" FontSize="20" FontWeight="SemiBold"
                   Foreground="{StaticResource Brush.TextPrimary}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1">
      <StackPanel MaxWidth="600" HorizontalAlignment="Center" Margin="0,0,0,40">

        <!-- ── Appearance ── -->
        <TextBlock Text="APPEARANCE" FontSize="11" FontWeight="SemiBold" LetterSpacing="3"
                   Foreground="{StaticResource Brush.TextMuted}" Margin="0,0,0,16"/>

        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12" VerticalAlignment="Center">
          <TextBlock Grid.Column="0" Text="Font size" FontSize="15"
                     Foreground="{StaticResource Brush.TextPrimary}" VerticalAlignment="Center"/>
          <NumericUpDown Grid.Column="1" Value="{Binding FontSize}"
                         Minimum="12" Maximum="32" Increment="1" Width="120"
                         FormatString="0 px"
                         Foreground="{StaticResource Brush.TextPrimary}"
                         Background="{StaticResource Brush.Surface}"/>
        </Grid>

        <Border Height="1" Background="{StaticResource Brush.BorderSubtle}" Margin="0,20,0,20"/>

        <!-- ── Session Defaults ── -->
        <TextBlock Text="SESSION DEFAULTS" FontSize="11" FontWeight="SemiBold" LetterSpacing="3"
                   Foreground="{StaticResource Brush.TextMuted}" Margin="0,0,0,16"/>

        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
          <TextBlock Grid.Column="0" Text="Default duration (minutes)" FontSize="15"
                     Foreground="{StaticResource Brush.TextPrimary}" VerticalAlignment="Center"/>
          <NumericUpDown Grid.Column="1" Value="{Binding DefaultDurationMinutes}"
                         Minimum="1" Maximum="120" Increment="5" Width="120" FormatString="0"
                         Foreground="{StaticResource Brush.TextPrimary}"
                         Background="{StaticResource Brush.Surface}"/>
        </Grid>

        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
          <TextBlock Grid.Column="0" Text="Default word goal" FontSize="15"
                     Foreground="{StaticResource Brush.TextPrimary}" VerticalAlignment="Center"/>
          <NumericUpDown Grid.Column="1" Value="{Binding DefaultMinWordCount}"
                         Minimum="10" Maximum="5000" Increment="50" Width="120" FormatString="0"
                         Foreground="{StaticResource Brush.TextPrimary}"
                         Background="{StaticResource Brush.Surface}"/>
        </Grid>

        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
          <TextBlock Grid.Column="0" Text="Default idle timeout (seconds)" FontSize="15"
                     Foreground="{StaticResource Brush.TextPrimary}" VerticalAlignment="Center"/>
          <NumericUpDown Grid.Column="1" Value="{Binding DefaultIdleTimeoutSeconds}"
                         Minimum="3" Maximum="60" Increment="1" Width="120" FormatString="0"
                         Foreground="{StaticResource Brush.TextPrimary}"
                         Background="{StaticResource Brush.Surface}"/>
        </Grid>

        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
          <TextBlock Grid.Column="0" Text="Paste abuse threshold (words)" FontSize="15"
                     Foreground="{StaticResource Brush.TextPrimary}" VerticalAlignment="Center"/>
          <NumericUpDown Grid.Column="1" Value="{Binding PasteAbuseThresholdWords}"
                         Minimum="10" Maximum="500" Increment="10" Width="120" FormatString="0"
                         Foreground="{StaticResource Brush.TextPrimary}"
                         Background="{StaticResource Brush.Surface}"/>
        </Grid>

        <Border Height="1" Background="{StaticResource Brush.BorderSubtle}" Margin="0,20,0,20"/>

        <!-- ── Storage ── -->
        <TextBlock Text="STORAGE" FontSize="11" FontWeight="SemiBold" LetterSpacing="3"
                   Foreground="{StaticResource Brush.TextMuted}" Margin="0,0,0,16"/>

        <TextBlock Text="Storage directory" FontSize="15"
                   Foreground="{StaticResource Brush.TextPrimary}" Margin="0,0,0,6"/>
        <TextBlock Text="Leave empty to use the default application data folder."
                   FontSize="12" Foreground="{StaticResource Brush.TextMuted}" Margin="0,0,0,8"/>
        <TextBox Text="{Binding StorageDirectory}"
                 PlaceholderText="C:\Users\you\Documents\Flowrite"
                 FontSize="14" Margin="0,0,0,8"/>

        <Border Height="1" Background="{StaticResource Brush.BorderSubtle}" Margin="0,20,0,20"/>

        <!-- ── AI Configuration ── -->
        <TextBlock Text="AI CONFIGURATION" FontSize="11" FontWeight="SemiBold" LetterSpacing="3"
                   Foreground="{StaticResource Brush.TextMuted}" Margin="0,0,0,8"/>
        <TextBlock Text="Optional. AI features are disabled unless an endpoint is configured."
                   FontSize="12" Foreground="{StaticResource Brush.TextMuted}" Margin="0,0,0,16"
                   TextWrapping="Wrap"/>

        <TextBlock Text="Endpoint URL" FontSize="14"
                   Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,0,6"/>
        <TextBox Text="{Binding AiEndpoint}"
                 PlaceholderText="http://localhost:11434/v1" FontSize="14" Margin="0,0,0,12"/>

        <TextBlock Text="API Key" FontSize="14"
                   Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,0,6"/>
        <TextBox Text="{Binding AiApiKey}"
                 PasswordChar="•"
                 PlaceholderText="sk-… (leave empty for local endpoints)" FontSize="14" Margin="0,0,0,12"/>

        <TextBlock Text="Model" FontSize="14"
                   Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,0,6"/>
        <TextBox Text="{Binding AiModel}"
                 PlaceholderText="llama3, gpt-4o, mistral…" FontSize="14" Margin="0,0,0,12"/>

        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
          <TextBlock Grid.Column="0" Text="Temperature" FontSize="14"
                     Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Center"/>
          <NumericUpDown Grid.Column="1" Value="{Binding AiTemperature}"
                         Minimum="0" Maximum="2" Increment="0.1" Width="140"
                         FormatString="0.0"
                         Foreground="{StaticResource Brush.TextPrimary}"
                         Background="{StaticResource Brush.Surface}"/>
        </Grid>

      </StackPanel>
    </ScrollViewer>

    <!-- Save bar -->
    <Border Grid.Row="2"
            Background="{StaticResource Brush.Background}"
            BorderBrush="{StaticResource Brush.BorderSubtle}"
            BorderThickness="0,1,0,0"
            Padding="40,16">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Text="{Binding SaveMessage}"
                   FontSize="14" Foreground="{StaticResource Brush.Success}"
                   VerticalAlignment="Center"
                   IsVisible="{Binding SaveMessage,
                     Converter={x:Static vm:StringNotEmptyConverter.Instance}}"/>
        <Button Grid.Column="1" Classes="primary" Command="{Binding SaveCommand}"
                Content="Save Settings" Padding="24,12"/>
      </Grid>
    </Border>

  </Grid>
</UserControl>
